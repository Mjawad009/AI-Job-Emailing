# Postgres connection string. On Railway, reference your Postgres service, e.g.:
#   postgresql://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outreach

# Only set to "require" if connecting to an external Postgres that enforces SSL.
# PGSSLMODE=require

SESSION_SECRET=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# REQUIRED and must be the real public URL once deployed — this gets embedded directly
# into tracking pixel and click-redirect links sent out in emails.
PUBLIC_URL=http://localhost:3000

PLATFORM_OPENROUTER_API_KEY=
PLATFORM_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
PLATFORM_KEY_DAILY_LIMIT=20

# How often (minutes) to automatically sweep all connected accounts for bounce
# notifications. Set to 0 to disable the automatic sweep (manual "check now" still works).
BOUNCE_CHECK_INTERVAL_MINUTES=15

# How often (minutes) to check for and send due follow-up sequence steps. Set to 0 to
# disable the automatic sweep (manual "Run due steps now" button on /sequences.html still works).
SEQUENCE_CHECK_INTERVAL_MINUTES=10

PORT=3000
